#!/usr/bin/env bash
# ponytail: dispatch, nothing else. All the logic is in src/.
set -euo pipefail
HERE="$(python3 -c 'import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "${BASH_SOURCE[0]}")"
SRC="$HERE/src"
case "${1:-board}" in
  gate)    shift; exec python3 "$SRC/merge_gate.py" "$@" ;;
  dispatch) shift; exec python3 "$SRC/dispatch.py" "$@" ;;
  packet)  shift; exec python3 "$SRC/packet.py" "$@" ;;
  audit)   shift; exec python3 "$SRC/audit.py" "$@" ;;
  deploy)  shift; exec python3 "$SRC/deploy.py" "$@" ;;
  reap)    shift; exec python3 "$SRC/tree_cleanup.py" "$@" ;;
  vet-dep) shift; exec node "$HERE/scripts/vet-dep.mjs" "$@" ;;
  paid-call) shift; exec python3 "$SRC/paid_call.py" "$@" ;;
  validate) shift; exec python3 "$SRC/validate.py" "$@" ;;
  tick)    exec python3 "$SRC/tick.py" ;;
  wait)    shift; exec python3 "$SRC/tick.py" wait "$@" ;;
  up)      shift; exec python3 "$SRC/up.py" "$@" ;;
  pane-end) shift; exec python3 "$SRC/pane_end.py" "$@" ;;
  think)   shift; exec python3 "$SRC/think.py" "$@" ;;
  carry)   shift; exec python3 "$SRC/carry.py" "$@" ;;
  note-close) shift; exec python3 "$SRC/notes.py" "$@" ;;
  guard)   shift; exec python3 "$SRC/guard.py" "$@" ;;
  models)  shift; exec python3 "$SRC/models.py" "$@" ;;
  version) cat "$HERE/VERSION" ;;
  backup)  shift; exec python3 "$SRC/backup.py" "$@" ;;
  restore) shift; exec python3 "$SRC/restore.py" "$@" ;;
  # ★ DISCOVERED, never enumerated. This was a hardcoded && chain of twelve
  # files, so a new src/test_*.py ran nowhere and its guard was advisory until
  # someone remembered to add it. The `· <file>` marker names the file that is
  # running now, so a hang is attributable.
  # Run-all, not fail-fast: the chain (and a bare `set -e` loop) hid every
  # failure after the first. One PASS/FAIL line per file, its output kept (a
  # swallowed traceback is an undiagnosable failure), non-zero if any failed.
  # The glob covers test_*.mjs too, so test_vet_dep.mjs needs no tail call.
  test)    cd "$SRC"
           rc=0
           for f in test_*.py test_*.mjs; do
             [ -e "$f" ] || continue
             printf '· %s\n' "$f"
             runner=python3
             if [ "${f%.mjs}" != "$f" ]; then runner=node; fi
             if out=$("$runner" "$f" 2>&1); then
               echo "PASS $f"
             else
               s=$?
               echo "FAIL $f (exit $s)"
               rc=1
             fi
             printf '%s\n' "$out"
           done
           exit "$rc" ;;
  help|-h|--help) cat <<'USAGE'
doit — a ledger that derives state, and the guards that read it

  doit                                    render the board
  doit states                             every derived state, one per line
  doit events <subject>                   one subject's events, oldest first
  doit spend <charter|spec|spawn-id>      per-spawn token table + totals; charter stage wall clock (read-only)
  doit append <type> <subject> [k=v ...]  append one event, then re-fold
  doit gate <branch> [main] [--spec ID]   merge guard. exit 1 = DO NOT MERGE
  doit packet <role> <subject> [...]      build that role's packet from the ledger (-h for flags)
  doit audit cut|plan <charter> --cut F [...]  the six mechanical checks under both fable audits (§3.6)
  doit vet-dep [--pypi] <pkg>... | --hook  the install gate, and the scout's ground truth (§6.7b)
  doit paid-call <label> -- <cmd...>      run a call that spends, log it, enforce the cap (§10.4)
  doit validate <role> <file>             the seat route's StructuredOutput: an Output object against its schema
  doit deploy <spec> --sha S --target T --cmd C --check C  serial; waits; proves the sha is live (§4.11)
  doit reap <charter> [--repo D] [--dry-run]   reap only the provably dead worktrees at close (§4.11)
  doit dispatch <role> <subject> [...]    spawn one contract, check it, append its events (-h for flags)
  doit tick                               fold; spawn the Executor only if the lane is actionable (D117)
  doit wait [--max SEC]                   block until the ledger changes or SEC pass (default 300), then tick
  doit up                                 start the Planner pane; print (never install) the tick's cron line
  doit pane-end <charter> --handover F [--root D]   the Planner's ⑦: end this pane's own process, if it may
  doit think <topic> | --land F… | --discard <topic>
                                          open a Thinker session, or land its charters (§3.3)
  doit carry <source> [--repo D] [--project N]
                                          carry an inbound v4 record (or PR url) into a charter:null spec-writer spawn
  doit note-close <pr> --response FILE   post FILE as the closing comment on an inbound-note PR, close it, record it
  doit models show | use <mixed|claude-only>   the root's model map: print it, or install a profile
  doit version                            print the release version (VERSION; CHANGELOG.md has the history)
  doit alloc <kind> [--dir]               claim the next L-<kind>-NNNN under content and print its path (§2.8)
  doit backup push | watch --for N | status | cron   replicate the ledger (§9.9)
  doit restore <snapshot> [--root D] [--dry-run] [--remote U]  rebuild from the mirror
  doit test                               run every check
  doit help

Environment
  DOIT_ROOT         where the ledger lives            (default ~/.do-it)
  $DOIT_ROOT/models.toml   contract -> backend -> model, decided once per root (template: models.example.toml)
  DOIT_PROJECT      scope the board to one project
  DOIT_LEDGER_FILE  which actor file you write as     (the filename IS the actor)
  DOIT_K            owed ACs a charter may close over (default 0 — deny)
  DOIT_SUPERVISED   set by a supervisor on every child it starts; `doit pane-end` refuses without it
  DOIT_INSTALL_OVERRIDE  a reason: vet-dep allows the blocked install and records it
  DOIT_SPEND_CAP_USD     paid-call refuses past this; there is no uncapped mode
  DOIT_RESTIC_REPO  backup destination
  DOIT_TICK_MIN     the cron interval; a tick older than 2× is STALE (default 5)
  DOIT_DEPLOY_TIMEOUT  wall-clock cap on a deploy, command plus wait (default 600)
  DOIT_REAP_DEPTH   how far back on main the reaper reads patch-ids  (default 200)

The ledger is append-only. Never edit or delete a line: repair with an
operator-only `correction` event.
USAGE
    ;;
  *)       exec python3 "$SRC/fold.py" "$@" ;;
esac
