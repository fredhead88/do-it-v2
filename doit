  up)      shift; exec python3 "$SRC/up.py" "$@" ;;
  relay)   shift; exec python3 "$SRC/up.py" --relay "$@" ;;
  launch)  shift; exec python3 "$SRC/launch.py" "$@" ;;
  pane-end) shift; exec python3 "$SRC/pane_end.py" "$@" ;;
  think)   shift; exec python3 "$SRC/think.py" "$@" ;;
  carry)   shift; exec python3 "$SRC/carry.py" "$@" ;;
  note-close) shift; exec python3 "$SRC/notes.py" "$@" ;;
  guard)   shift; exec python3 "$SRC/guard.py" "$@" ;;
  throughput) shift; exec python3 "$SRC/throughput.py" "$@" ;;
  problems) shift; exec python3 "$SRC/problems.py" "$@" ;;
  balance) shift; exec python3 "$SRC/balance.py" "$@" ;;
  models)  shift; exec python3 "$SRC/models.py" "$@" ;;
  version) cat "$HERE/VERSION" ;;
  backup)  shift; exec python3 "$SRC/backup.py" "$@" ;;
  restore) shift; exec python3 "$SRC/restore.py" "$@" ;;
  crons)   shift; exec python3 "$SRC/crons.py" "$@" ;;
  seat-usage) shift; exec python3 "$SRC/seat_usage.py" "$@" ;;
  cron-run) shift; exec python3 "$SRC/cron_run.py" "$@" ;;
  health-alarms) shift; exec python3 "$SRC/health_alarms.py" "$@" ;;
  lane-rules) shift; exec python3 "$SRC/lane_rules.py" "$@" ;;
  stuck-digest) shift; exec python3 "$SRC/stuck_digest.py" "$@" ;;
  owed-backfill) shift; exec python3 "$SRC/owed_backfill.py" "$@" ;;
  owed-digest) shift; exec python3 "$SRC/owed_digest.py" "$@" ;;
  verify-owed) shift; exec python3 "$SRC/verifier.py" "$@" ;;
  sweep-owed) shift; exec python3 "$SRC/sweep_owed.py" "$@" ;;
  proving) shift; exec python3 "$SRC/proving.py" "$@" ;;
  # ★ DISCOVERED, never enumerated. This was a hardcoded && chain of twelve
  # files, so a new src/test_*.py ran nowhere and its guard was advisory until
  # someone remembered to add it. The `· <file>` marker names the file that is
  # running now, so a hang is attributable.
  # Run-all, not fail-fast: the chain (and a bare `set -e` loop) hid every
  # failure after the first. One PASS/FAIL line per file, its output kept (a
  # swallowed traceback is an undiagnosable failure), non-zero if any failed.
  # The glob covers test_*.mjs too, so test_vet_dep.mjs needs no tail call.
  # R8.1: every runner starts under a fresh, throwaway HOME/DOIT_ROOT/
  # XDG_CONFIG_HOME — all under ONE mktemp -d, removed on exit (the trap fires
  # on the failure path too, via `exit "$rc"`) — and DOIT_LEDGER_FILE unset, so
  # `doit test` can never scribble over the real agent links or the real
  # ledger, however a test file gets there.
  test)    shift
           if [ "$#" -eq 1 ]; then
             if [ "$1" != --live ]; then
               echo 'usage: doit test [--live]' >&2
               exit 2
             fi
             # Capture the caller's root before replacing HOME/DOIT_ROOT.
             export DOIT_TEST_LIVE_ROOT
             DOIT_TEST_LIVE_ROOT=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "${DOIT_ROOT:-$HOME/.do-it}")
           elif [ "$#" -eq 0 ]; then
             unset DOIT_TEST_LIVE_ROOT
           else
             echo 'usage: doit test [--live]' >&2
             exit 2
           fi
           cd "$SRC"
           DOIT_TEST_ISO=$(mktemp -d)
           trap 'rm -rf "$DOIT_TEST_ISO"' EXIT
           mkdir -p "$DOIT_TEST_ISO/home" "$DOIT_TEST_ISO/root" "$DOIT_TEST_ISO/xdg"
           export HOME="$DOIT_TEST_ISO/home" DOIT_ROOT="$DOIT_TEST_ISO/root" \
                  XDG_CONFIG_HOME="$DOIT_TEST_ISO/xdg"
           unset DOIT_LEDGER_FILE
           rc=0
           if [ -n "${DOIT_TEST_LIVE_ROOT:-}" ]; then
             # No ledger or an unreadable ledger is undetermined, never green.
             if ! python3 - "$DOIT_TEST_LIVE_ROOT" <<'PY'
import pathlib, sys
try:
    files = [p for p in (pathlib.Path(sys.argv[1]) / "events").iterdir()
             if p.suffix == ".jsonl"]
    if not files:
        sys.exit(3)
    for path in files:
        with path.open():
            pass
except OSError:
    sys.exit(3)
PY
             then
               echo 'live: not run'
               exit 3
             fi
             for f in test_harvest.py test_problem_backfill.py; do
               if [ "$f" = test_harvest.py ]; then
                 live_check=check_ledger
               else
                 live_check=test_real_ledger_ac3_help_and_ac7
               fi
               printf 'live-check %s:%s\n' "$f" "$live_check"
               if python3 "$f" --live; then
                 :
               else
                 s=$?
                 if [ "$s" -eq 3 ]; then
                   if [ "$rc" -eq 0 ]; then rc=3; fi
                 else
                   rc=1
                 fi
               fi
             done
             if [ "$rc" -eq 0 ]; then
               echo 'live: pass'
             elif [ "$rc" -eq 3 ]; then
               echo 'live: not run'
             else
               echo 'live: fail'
             fi
             exit "$rc"
           fi
           # grader_view checks archives/diffs against a local main/master.
           # A branch-only clone has neither. Supply its baseline in a
           # disposable shared clone, without changing the caller's refs.
           DOIT_TEST_GRADER_REPO="$HERE"
           if [ -f "$SRC/test_grader_view.py" ]; then
             if git -C "$HERE" merge-base HEAD main >/dev/null 2>&1; then
               :
             elif git -C "$HERE" merge-base HEAD master >/dev/null 2>&1; then
               :
             else
               DOIT_TEST_GRADER_REPO="$DOIT_TEST_ISO/grader-repo"
               git clone -q --shared "$HERE" "$DOIT_TEST_GRADER_REPO"
               grader_base=$(git -C "$HERE" rev-parse --verify origin/main 2>/dev/null || \
                             git -C "$HERE" rev-parse --verify origin/master 2>/dev/null || \
                             git -C "$HERE" rev-parse --verify HEAD^)
               git -C "$DOIT_TEST_GRADER_REPO" branch master "$grader_base"
             fi
           fi
           for f in test_*.py test_*.mjs; do
             [ -e "$f" ] || continue
             printf '· %s\n' "$f"
             runner=python3
             if [ "${f%.mjs}" != "$f" ]; then runner=node; fi
             test_file="$f"
             if [ "$f" = test_grader_view.py ]; then
               test_file="$DOIT_TEST_GRADER_REPO/src/$f"
             fi
             if out=$("$runner" "$test_file" 2>&1); then
               echo "PASS $f"
             else
               s=$?
               echo "FAIL $f (exit $s)"
               rc=1
             fi
             printf '%s\n' "$out"
           done
           exit "$rc" ;;
  help|-h|--help) cat <<'USAGE'
doit — a ledger that derives state, and the guards that read it

