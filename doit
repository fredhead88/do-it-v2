#!/usr/bin/env bash
# ponytail: dispatch, nothing else. All the logic is in src/.
set -euo pipefail
HERE="$(python3 -c 'import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "${BASH_SOURCE[0]}")"
SRC="$HERE/src"
