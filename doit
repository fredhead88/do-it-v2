  doit cron-run NAME -- CMD...            wrap CMD, recording start/outcome/duration per run
                                          to $R/state/cron-runs/NAME.jsonl (L-charter-0042 R14a)
  doit health-alarms [--dry-run]  evaluate and record local health alarms
  doit lane-rules [--json] [--table PATH]  read-only lane conditions and deadlines
  doit stuck-digest [--send] [--dry-run]  daily stuck summary
  doit owed-backfill [--apply] [--audit DIR] [--labels FILE]  plan or apply audited backlog repair
