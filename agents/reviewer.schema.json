{
  "title": "reviewer Output — blocking and advisory separated in the schema (§4.6·5, D29, D72, D82, D101)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "depth",
    "round",
    "blocking",
    "recommendations",
    "reverify",
    "offer",
    "unverifiable",
    "cleared",
    "escalations",
    "declarations"
  ],
  "properties": {
    "depth": {
      "type": "string",
      "enum": [
        "full",
        "gates-only"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "blocking": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ac",
          "finding",
          "reverify"
        ],
        "properties": {
          "ac": {
            "type": "string",
            "maxLength": 20,
            "description": "the criterion this finding violates — a finding with no criterion cannot block"
          },
          "finding": {
            "type": "string",
            "maxLength": 400
          },
          "reverify": {
            "type": "string",
            "maxLength": 300,
            "description": "a runnable condition that, when it holds, clears this finding"
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "finding"
        ],
        "properties": {
          "category": {
            "type": "string",
            "maxLength": 40
          },
          "finding": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "reverify": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition",
          "negative"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "maxLength": 300
          },
          "negative": {
            "type": "boolean",
            "description": "true when this is a must-not-happen condition"
          }
        }
      }
    },
    "offer": {
      "type": "array",
      "maxItems": 3,
      "description": "0–3 items, ranked; empty is a first-class output",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "what",
          "artifact"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "what": {
            "type": "string",
            "maxLength": 200
          },
          "artifact": {
            "type": "string",
            "maxLength": 200,
            "description": "which artifact to look at"
          }
        }
      }
    },
    "unverifiable": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ac",
          "why"
        ],
        "properties": {
          "ac": {
            "type": "string",
            "maxLength": 20
          },
          "why": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "cleared": {
      "type": "array",
      "maxItems": 40,
      "description": "round 2 only",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ac",
          "evidence"
        ],
        "properties": {
          "ac": {
            "type": "string",
            "maxLength": 20
          },
          "evidence": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "escalations": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asks",
          "blocks",
          "default",
          "deadline"
        ],
        "properties": {
          "asks": {
            "type": "string",
            "maxLength": 300
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "default": {
            "type": "string",
            "maxLength": 300
          },
          "deadline": {
            "type": "string",
            "maxLength": 40
          }
        }
      }
    },
    "declarations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "line"
        ],
        "properties": {
          "term": {
            "type": "string",
            "enum": [
              "hollow",
              "post-ship-defect",
              "regression",
              "rework",
              "blocked-external",
              "evidence-gap",
              "unverifiable"
            ]
          },
          "line": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}
